# Copy to .env and adjust if needed.
# The values below match the defaults in docker-compose.yml
# and are valid for local development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metheon
POSTGRES_USER=metheon
POSTGRES_PASSWORD=metheon

# USGS ingestion. Any GeoJSON summary feed works: all_day is a few hundred
# events, all_week around two thousand, all_month over ten thousand.
# https://earthquake.usgs.gov/earthquakes/feed/v1.0/geojson.php
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_week.geojson
USGS_TIMEOUT_SECONDS=30

# INGV ingestion. The service answers a query rather than serving a fixed
# feed: a starttime covering the last INGV_DAYS is added at request time.
# https://webservices.ingv.it/
INGV_FEED_URL=https://webservices.ingv.it/fdsnws/event/1/query?format=geojson&limit=5000
INGV_TIMEOUT_SECONDS=30
INGV_DAYS=7

# Redis job queue. The worker running in Docker Compose overrides
# REDIS_HOST to `redis`; locally the published port is used.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
QUEUE_NAME=metheon:imports
QUEUE_BLOCK_TIMEOUT_SECONDS=5
QUEUE_RETRY_DELAY_SECONDS=5
LOG_LEVEL=INFO
