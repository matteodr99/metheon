# Copy to .env and adjust if needed.
# The values below match the defaults in docker-compose.yml
# and are valid for local development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metheon
POSTGRES_USER=metheon
POSTGRES_PASSWORD=metheon

# USGS ingestion. Any GeoJSON summary feed works; all_hour is smaller
# and handy while developing.
# https://earthquake.usgs.gov/earthquakes/feed/v1.0/geojson.php
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_TIMEOUT_SECONDS=30
